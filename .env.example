# ===== MongoDB Atlas =====
MONGODB_URI=mongodb+srv://<user>:<pass>@<cluster>/?retryWrites=true&w=majority
MONGODB_DB=trilho_pagamentos
# Scripts que escrevem (scripts/reset_demo.py, geradores, experimentos) recusam um banco
# que não termine em _test. Para recriar a demo, rode-os com ALLOW_DEMO_DB_WRITE=1.

# ===== Time series =====
# O bucket (bucketMaxSpanSeconds=86400) é definido na criação da coleção pelo gerador
# (--variant span1d); depois só pode aumentar (collMod), nunca diminuir — ver
# docs/adr/0001-bucketing.md.
TS_EXPIRE_AFTER_SECONDS=0
TS_MAX_TIME_MS=15000
TS_MAX_RANGE_DAYS=30
TS_MAX_POINTS=4000

# ===== Detecção de degradação =====
# Desvio da própria linha de base do provedor, não limiar absoluto: ver o controle
# negativo em degradation_scenarios.
Z_SCORE_THRESHOLD=3.0
Z_MIN_WINDOWS=3
Z_BASELINE_WINDOWS=96
Z_BASELINE_LAG=4
MIN_DELTA_PP=1.5
MIN_DELTA_RATIO=0.35
MIN_P99_RATIO=1.5
MIN_EVENTS_PER_WINDOW=30

# ===== Velocity da conta (feature de antifraude) =====
VELOCITY_WINDOWS=1,6,24

# ===== Geração de dados =====
DAYS=7
EVENTS_PER_SECOND=75
ACCOUNTS=2000000
SEED=42

# ===== Ingestão ao vivo (botão play) =====
# TTL curto: o dado ao vivo some sozinho e o roteiro pode rodar de novo.
LIVE_TTL_SECONDS=3600
LIVE_TICK_SECONDS=1.0
LIVE_MINUTES_PER_TICK=5
# Média diária nominal; às 10h a curva observada fica em aproximadamente 2,3 k/s.
LIVE_TARGET_EPS=1500
LIVE_ROLLING_SECONDS=15
LIVE_MIN_EVENTS=20
LIVE_CONFIDENCE_SIGMAS=3.0

# Cache do painel de armazenamento: $collStats sobre milhões de buckets leva ~32 s
# a frio, e o backend aquece uma vez no startup.
STORAGE_CACHE_SECONDS=600

# ===== Ciclo de vida =====
# Online Archive / Data Federation exigem tier dedicado.
ARCHIVE_ENABLED=false
FEDERATED_URI=

# ===== App =====
BACKEND_PORT=8400
FRONTEND_PORT=5400
LOG_LEVEL=INFO

# ===== Caso de negócio =====
# NÃO são medições: são os números do cliente, e a tela os rotula como tais.
CUSTO_MINUTO_INDISPONIVEL=0
TICKET_MEDIO_REFERENCIA=0
CURRENCY=R$
